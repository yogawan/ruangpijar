# MongoDB connection string used by lib/mongodb.ts
MONGODB_URI=mongodb://localhost:27017/ruangpijar

# NextAuth (Auth.js v5) — required in production
AUTH_SECRET=

# Google OAuth provider (matches User.googleId)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Nodemailer (Gmail SMTP + App Password) — used by lib/email.ts to send
# check-in streak reminder/reset emails from /api/cron/streak-check
EMAIL_USER=
EMAIL_PASS=

# Shared secret for /api/cron/streak-check. Vercel Cron sends it back
# automatically as `Authorization: Bearer <value>` when this is set on the
# project; any other scheduler must send that same header itself.
CRON_SECRET=

# Cloudinary — used by lib/cloudinary.ts for POST /api/upload (profile
# avatar uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
